{
  "name": "image-charts-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.image-charts/image-charts-mcp",
  "description": "Model Context Protocol server that turns an agent's chart request into a permanent, hosted, shareable Image-Charts image URL.",
  "type": "module",
  "bin": {
    "image-charts-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-charts",
    "charts",
    "qrcode",
    "hosted-image-url"
  ],
  "license": "MIT",
  "author": "Image-Charts (https://www.image-charts.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/image-charts/image-charts-mcp.git"
  },
  "homepage": "https://github.com/image-charts/image-charts-mcp#readme",
  "bugs": {
    "url": "https://github.com/image-charts/image-charts-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "image-charts": "^6.1.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
